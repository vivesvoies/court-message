[Unit]
Description=CM SMS gateway (SIM modem <-> court-message)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/cm-sms-gateway/cm_sms_gateway.py /etc/cm-sms-gateway.conf
Restart=always
RestartSec=10
# L'accès au modem série requiert le groupe dialout.
User=cm-gateway
SupplementaryGroups=dialout
# Durcissement.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# Crée /var/lib/cm-sms-gateway (accessible en écriture) pour le journal
# d'envois en attente d'accusé de réception, malgré ProtectSystem=strict.
StateDirectory=cm-sms-gateway

[Install]
WantedBy=multi-user.target
