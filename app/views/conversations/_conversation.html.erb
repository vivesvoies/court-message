<%= turbo_stream_from "conversation_list_item_#{conversation.id}" %>
<li class="Conversation <%= "Conversation--active" if current_conversation?(conversation) %> Conversation--<%= conversation.status %>"
    data-conversation-list-target="conversation"
    data-conversation-status-url="<%= read_status_team_conversation_path(conversation.team, conversation.id) %>"
    id="<%= dom_id conversation %>">
  <%= link_to [conversation.team, conversation], class: "Conversation__link", data: { turbo_frame: :primary, turbo_action: "advance", action: "conversation-list#activate", turbo_prefetch: false } do %>
    <div class="Conversation__latest">
      <%= time_stamp_for conversation.timestamp %>
    </div>
    <div class="Conversation__status <%= "Conversation__status--warning" if conversation.delivery_failed? %>">
      <% if conversation.delivery_failed? %>
        <i class="cm-icon-warning" title="<%= t("conversations.conversation.delivery_failed") %>"></i>
      <% elsif conversation.unread? %>
        <%= unread_badge_for conversation %>
      <% end %>
    </div>
    <div class="Conversation__preview">
      <div class="Conversation__contact">
        <%= conversation.title %>
      </div>
      <div class="Conversation__sub <%= last_message_class_for conversation %>">
        <%= last_message_extract_for conversation %>
      </div>
    </div>
    <div class="Conversation__agents"></div>
  <% end %>
</li>
